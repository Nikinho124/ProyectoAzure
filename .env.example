# Solo para desarrollo local; genera una clave propia y no reutilices esta plantilla en producción.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Enable only when a trusted reverse proxy overwrites X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=false
